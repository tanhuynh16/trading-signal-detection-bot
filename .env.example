# Spec §25: real values live only in .env (gitignored) or a secret manager.
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://sdb:sdb@localhost:5432/sdb
REDIS_URL=redis://localhost:6379

# Alchemy Base Mainnet. WSS drives discovery (§10.2); HTTP serves reads/multicall.
BASE_RPC_HTTP_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_WSS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_CHAIN_ID=8453

# Spec §11 quote-token allowlist, lowercase, comma separated.
# WETH, USDC, DAI on Base — verify each against the official Base token list
# before trusting them in production.
QUOTE_TOKEN_ALLOWLIST=0x4200000000000000000000000000000000000006,0x833589fcd6edb6e08f4c7c32d4f71b54bda02913,0x50c5725949a6f0c72e6c4a641f24049a917db0cb

# Phase 6 only. Leave unset until then; notifications stay disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifier circuit breaker (ADR 0018). A globally broken transport — a wrong
# chat id, a revoked token — is held open rather than retried per token, so a
# misconfiguration cannot produce one failed send per feature evaluation.
# While open, alerts stay PENDING and drain once delivery recovers.
NOTIFIER_CIRCUIT_ENABLED=true
NOTIFIER_CIRCUIT_FAILURE_THRESHOLD=3
NOTIFIER_CIRCUIT_OPEN_MS=300000

API_PORT=3000
DISCOVERY_BLOCK_OVERLAP=50
# Provider cap on the eth_getLogs span. Alchemy's free tier allows 10 blocks;
# paid tiers allow far more. Too high self-corrects (the fetcher halves and
# remembers), but costs probe requests on the first drain.
DISCOVERY_LOG_CHUNK_BLOCKS=10
DISCOVERY_FIRST_START_BACKFILL_BLOCKS=300
DISCOVERY_POLL_INTERVAL_MS=15000
# Aerodrome stable pools pair correlated assets; meme tokens launch in volatile.
AERODROME_INCLUDE_STABLE=false
STRATEGY_VERSION=base-meme-v1
